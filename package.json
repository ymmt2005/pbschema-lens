{
  "name": "pbschema-lens",
  "version": "0.7.0",
  "description": "Open-source static schema explorer for Protocol Buffers",
  "type": "module",
  "scripts": {
    "build:ui": "vite build --config ui/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "test:links": "node --test scripts/check-links.test.mjs && node scripts/check-links.mjs",
    "test:updates": "node --test scripts/dependency-policy.test.mjs scripts/action-updates.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ymmt2005/pbschema-lens.git"
  },
  "homepage": "https://github.com/ymmt2005/pbschema-lens#readme",
  "bugs": {
    "url": "https://github.com/ymmt2005/pbschema-lens/issues"
  },
  "engines": {
    "node": "24.21.0"
  },
  "keywords": [
    "protobuf",
    "protocol-buffers",
    "documentation",
    "static-site",
    "grpc",
    "buf"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/sanitize-html": "^2.16.2",
    "marked": "^18.1.1",
    "sanitize-html": "^2.18.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
