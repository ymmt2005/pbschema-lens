{
  "name": "pbschema-lens",
  "version": "0.3.0",
  "description": "Open-source static schema explorer for Protocol Buffers",
  "type": "module",
  "bin": {
    "pbschema-lens": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "site",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "example": "tsx src/cli.ts build examples/acme --out examples/acme/dist",
    "preview": "tsx src/cli.ts build examples/acme --out examples/acme/dist && astro preview --root site --port 43147 --host 127.0.0.1",
    "pack:smoke": "bash scripts/pack-smoke.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ymmt2005/pbschema-lens.git"
  },
  "homepage": "https://github.com/ymmt2005/pbschema-lens#readme",
  "bugs": {
    "url": "https://github.com/ymmt2005/pbschema-lens/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "protobuf",
    "protocol-buffers",
    "documentation",
    "static-site",
    "grpc",
    "buf"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protobuf": "^2.15.0",
    "astro": "^7.3.3",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "marked": "^18.0.13",
    "minimatch": "^10.2.6",
    "pagefind": "^1.5.2",
    "sanitize-html": "^2.17.7",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/sanitize-html": "^2.16.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
