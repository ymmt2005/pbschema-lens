{
  "name": "pbschema-lens",
  "version": "0.6.2",
  "description": "Open-source static schema explorer for Protocol Buffers",
  "type": "module",
  "scripts": {
    "build:ui": "vite build --config ui/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ymmt2005/pbschema-lens.git"
  },
  "homepage": "https://github.com/ymmt2005/pbschema-lens#readme",
  "bugs": {
    "url": "https://github.com/ymmt2005/pbschema-lens/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "protobuf",
    "protocol-buffers",
    "documentation",
    "static-site",
    "grpc",
    "buf"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/sanitize-html": "^2.16.2",
    "marked": "^18.0.14",
    "sanitize-html": "^2.18.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
