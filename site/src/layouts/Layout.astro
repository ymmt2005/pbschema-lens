---
import "../styles/global.css";
import PackageTree from "../components/PackageTree.astro";
import { activePackageName, buildPackageNavTree } from "pbschema-lens/core";
import { canonicalHref, configuredBase, loadModel, withBase } from "../lib/data.ts";
import { THEME_CHOICES, themeBootScript } from "../lib/theme.ts";

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const model = loadModel();
const pageTitle = title ? `${title} · ${model.title}` : model.title;
const canonical = canonicalHref(Astro.site, Astro.url.pathname);
const base = configuredBase();
const localPackages = model.packages.filter((item) => item.inNav && item.domain === "local");
const wktPackages = model.packages.filter((item) => item.domain === "well-known" && item.generatePage);
const current = Astro.url.pathname;
const packageTree = buildPackageNavTree(
  localPackages.map((pkg) => ({ fullName: pkg.fullName, urlPath: pkg.urlPath })),
);
const activePackage = activePackageName(
  current,
  localPackages.map((pkg) => ({ fullName: pkg.fullName })),
);
---

<!doctype html>
<html lang="en" data-base={base}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline set:html={themeBootScript()} />
  </head>
  <body class="min-h-screen">
    <div class="lg:grid lg:grid-cols-[18rem_1fr] min-h-screen">
      <aside
        id="sidebar"
        class="hidden lg:flex flex-col border-r border-[color:var(--line)] bg-[color:var(--bg-raised)] px-4 py-5 gap-6"
      >
        <a href={withBase("/")} class="no-underline text-[color:var(--fg)]">
          <div class="text-[11px] tracking-[0.12em] text-[color:var(--accent)] font-semibold">pbschema-lens</div>
          <div class="text-lg font-semibold leading-tight mt-1">{model.title}</div>
        </a>
        <nav class="text-sm space-y-4 overflow-y-auto">
          <div>
            <div class="text-[11px] uppercase tracking-wider text-[color:var(--fg-muted)] mb-2">API Reference</div>
            <PackageTree nodes={packageTree} active={activePackage} />
            {
              localPackages.length === 0 && (
                <p class="text-[color:var(--fg-muted)] px-2">No local packages in this build.</p>
              )
            }
          </div>
          {
            wktPackages.length > 0 && (
              <div>
                <div class="text-[11px] uppercase tracking-wider text-[color:var(--fg-muted)] mb-2">
                  Protobuf standard library
                </div>
                <ul class="space-y-1">
                  {wktPackages.map((pkg) => (
                    <li>
                      <a class="block rounded-md px-2 py-1 no-underline text-[color:var(--fg)] hover:bg-[color:var(--bg-muted)]" href={withBase(pkg.urlPath)}>
                        {pkg.fullName}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
          <div>
            <div class="text-[11px] uppercase tracking-wider text-[color:var(--fg-muted)] mb-2">Explore</div>
            <ul class="space-y-1">
              <li><a class="block px-2 py-1 no-underline text-[color:var(--fg)] hover:bg-[color:var(--bg-muted)] rounded-md" href={withBase("/explore/")}>Used-by explorer</a></li>
              <li><a class="block px-2 py-1 no-underline text-[color:var(--fg)] hover:bg-[color:var(--bg-muted)] rounded-md" href={withBase("/graph/")}>Package graph</a></li>
              <li><a class="block px-2 py-1 no-underline text-[color:var(--fg)] hover:bg-[color:var(--bg-muted)] rounded-md" href={withBase("/search/")}>Search</a></li>
              {model.files.some((file) => file.sourceText) && (
                <li><a class="block px-2 py-1 no-underline text-[color:var(--fg)] hover:bg-[color:var(--bg-muted)] rounded-md" href={withBase("/source/")}>Source</a></li>
              )}
              {model.diff && (
                <li><a class="block px-2 py-1 no-underline text-[color:var(--fg)] hover:bg-[color:var(--bg-muted)] rounded-md" href={withBase("/diff/")}>Schema diff</a></li>
              )}
            </ul>
          </div>
        </nav>
      </aside>
      <div class="min-w-0">
        <header class="sticky top-0 z-20 border-b border-[color:var(--line)] bg-[color:var(--bg)]/90 backdrop-blur">
          <div class="flex items-center gap-3 px-4 py-3">
            <button
              id="menu-btn"
              class="lg:hidden rounded-md border border-[color:var(--line)] px-2 py-1 text-sm"
              type="button"
            >
              Menu
            </button>
            <button
              id="search-open"
              class="flex-1 text-left rounded-md border border-[color:var(--line)] bg-[color:var(--bg-raised)] px-3 py-2 text-sm text-[color:var(--fg-muted)]"
              type="button"
            >
              Search symbols and comments…
              <kbd class="hidden sm:inline float-right text-[11px] border border-[color:var(--line)] rounded px-1">/</kbd>
            </button>
            <div class="relative shrink-0">
              <button
                id="theme-menu-button"
                class="rounded-md border border-[color:var(--line)] px-2 py-1 text-sm"
                type="button"
                aria-haspopup="menu"
                aria-expanded="false"
                aria-controls="theme-menu"
              >
                Theme
              </button>
              <div
                id="theme-menu"
                class="absolute right-0 z-30 mt-1 min-w-44 rounded-md border border-[color:var(--line)] bg-[color:var(--bg-raised)] py-1 text-sm shadow-[var(--shadow)]"
                role="menu"
                aria-label="Theme"
                hidden
              >
                {THEME_CHOICES.map((choice) => (
                  <button
                    class="grid w-full grid-cols-[1rem_1fr] items-center gap-2 px-3 py-1.5 text-left whitespace-nowrap text-[color:var(--fg)] hover:bg-[color:var(--bg-muted)] aria-checked:bg-[color:var(--bg-muted)]"
                    type="button"
                    role="menuitemradio"
                    data-theme-choice={choice.value}
                    aria-checked="false"
                  >
                    <span class="theme-mark text-[color:var(--accent)]" aria-hidden="true"></span>
                    {choice.label}
                  </button>
                ))}
              </div>
            </div>
          </div>
        </header>
    <main class="w-full min-w-0 px-4 py-8 sm:px-8" data-pagefind-body>
          <slot />
        </main>
      </div>
    </div>

    <div id="mobile-nav" class="hidden fixed inset-0 z-30 bg-black/50 lg:hidden">
      <div class="h-full w-72 bg-[color:var(--bg-raised)] p-4 overflow-y-auto">
        <button id="menu-close" class="mb-4 text-sm" type="button">Close</button>
        <a href={withBase("/")} class="block font-semibold mb-4 no-underline text-[color:var(--fg)]">{model.title}</a>
        <div class="text-[11px] uppercase tracking-wider text-[color:var(--fg-muted)] mb-2">API Reference</div>
        <PackageTree nodes={packageTree} active={activePackage} />
      </div>
    </div>

    <dialog id="search-dialog" class="w-[min(720px,92vw)] rounded-xl border border-[color:var(--line)] bg-[color:var(--bg-raised)] p-0 text-[color:var(--fg)] shadow-[var(--shadow)]">
      <div class="p-3 border-b border-[color:var(--line)]">
        <input
          id="search-input"
          class="w-full bg-transparent outline-none text-base"
          placeholder="Search symbols, comments, options…"
        />
        <div id="search-filters" class="flex flex-wrap gap-1 mt-2 text-xs"></div>
      </div>
      <div id="search-results" class="max-h-[60vh] overflow-y-auto p-2 text-sm"></div>
    </dialog>

    <script>
      import { rankSymbol } from "pbschema-lens/core";
      import { pagefindHitHtml, symbolHitHtml } from "../lib/search-ui.ts";
      import { THEME_STORAGE_KEY, themeChoice, themeStorageValue, useDarkTheme } from "../lib/theme.ts";

      const html = document.documentElement;
      const desktopTheme = window.matchMedia("(prefers-color-scheme: dark)");
      const themeButton = document.getElementById("theme-menu-button");
      const themeMenu = document.getElementById("theme-menu");
      const themeItems = () => [...(themeMenu?.querySelectorAll<HTMLButtonElement>("[data-theme-choice]") ?? [])];
      function applyTheme() {
        const stored = localStorage.getItem(THEME_STORAGE_KEY);
        html.classList.toggle("dark", useDarkTheme(stored, desktopTheme.matches));
        const current = themeChoice(stored);
        for (const item of themeItems()) {
          item.setAttribute("aria-checked", item.dataset.themeChoice === current ? "true" : "false");
        }
      }
      function setThemeMenuOpen(open: boolean) {
        if (!themeMenu || !themeButton) return;
        themeMenu.hidden = !open;
        themeButton.setAttribute("aria-expanded", open ? "true" : "false");
        if (open) themeItems().find((item) => item.getAttribute("aria-checked") === "true")?.focus();
      }
      desktopTheme.addEventListener("change", () => {
        if (themeChoice(localStorage.getItem(THEME_STORAGE_KEY)) !== "system") return;
        applyTheme();
      });
      themeButton?.addEventListener("click", () => setThemeMenuOpen(themeMenu?.hidden !== false));
      themeMenu?.addEventListener("click", (event) => {
        const item = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-theme-choice]");
        if (!item?.dataset.themeChoice) return;
        const value = themeStorageValue(item.dataset.themeChoice);
        if (value) localStorage.setItem(THEME_STORAGE_KEY, value);
        else localStorage.removeItem(THEME_STORAGE_KEY);
        applyTheme();
        setThemeMenuOpen(false);
        themeButton?.focus();
      });
      themeMenu?.addEventListener("keydown", (event) => {
        const items = themeItems();
        const index = items.indexOf(document.activeElement as HTMLButtonElement);
        if (event.key === "ArrowDown" || event.key === "ArrowUp") {
          event.preventDefault();
          const next = event.key === "ArrowDown" ? index + 1 : index - 1;
          items[(next + items.length) % items.length]?.focus();
        }
      });
      document.addEventListener("click", (event) => {
        if (!themeMenu || themeMenu.hidden) return;
        const target = event.target as Node;
        if (themeMenu.contains(target) || themeButton?.contains(target)) return;
        setThemeMenuOpen(false);
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && themeMenu && !themeMenu.hidden) {
          setThemeMenuOpen(false);
          themeButton?.focus();
        }
      });
      applyTheme();
      const mobile = document.getElementById("mobile-nav");
      document.getElementById("menu-btn")?.addEventListener("click", () => mobile?.classList.remove("hidden"));
      document.getElementById("menu-close")?.addEventListener("click", () => mobile?.classList.add("hidden"));
      const dialog = document.getElementById("search-dialog") as HTMLDialogElement | null;
      const input = document.getElementById("search-input") as HTMLInputElement | null;
      const results = document.getElementById("search-results");
      const filters = document.getElementById("search-filters");
      const kinds = ["all", "service", "method", "message", "field", "enum", "extension", "package"];
      let activeKind = "all";
      let symbols: Array<{ kind: string; name: string; fullName: string; urlPath: string }> = [];
      const base = html.dataset.base || "/";
      const prefix = base.endsWith("/") ? base.slice(0, -1) : base;

      kinds.forEach((kind) => {
        const btn = document.createElement("button");
        btn.textContent = kind;
        btn.className = "rounded-full border border-[color:var(--line)] px-2 py-0.5 capitalize";
        btn.dataset.kind = kind;
        btn.addEventListener("click", () => {
          activeKind = kind;
          [...filters.children].forEach((child) => child.classList.toggle("bg-[color:var(--bg-muted)]", child.dataset.kind === kind));
          runSearch();
        });
        filters?.append(btn);
      });
      filters?.querySelector("button")?.classList.add("bg-[color:var(--bg-muted)]");

      async function ensureIndex() {
        if (symbols.length) return;
        const res = await fetch(`${prefix}/assets/protobuf/symbols.json`);
        symbols = await res.json();
      }

      async function runSearch() {
        if (!input || !results) return;
        const q = input.value.trim();
        results.innerHTML = "";
        if (!q) {
          results.innerHTML = `<p class="p-3 text-[color:var(--fg-muted)]">Type a protobuf name, or search comments.</p>`;
          return;
        }
        await ensureIndex();
        const hits = symbols
          .filter((entry) => activeKind === "all" || entry.kind === activeKind)
          .map((entry) => ({ entry, score: rankSymbol(entry, q) }))
          .filter((hit) => hit.score > 0)
          .sort((a, b) => b.score - a.score)
          .slice(0, 20);
        if (!hits.length) {
          results.innerHTML = `<p class="p-3">No symbol matches.</p>`;
        } else {
          for (const hit of hits) {
            const a = document.createElement("a");
            a.href = `${prefix}${hit.entry.urlPath}`;
            a.className = "block rounded-md px-3 py-2 hover:bg-[color:var(--bg-muted)] no-underline text-[color:var(--fg)]";
            a.innerHTML = symbolHitHtml(hit.entry.kind, hit.entry.fullName);
            results.append(a);
          }
        }
        try {
          const pagefindUrl = `${prefix}/pagefind/pagefind.js`;
          const pagefind = await import(/* @vite-ignore */ pagefindUrl);
          await pagefind.init();
          const found = await pagefind.search(q);
          const data = await Promise.all((found.results ?? []).slice(0, 8).map((item: { data: () => Promise<{ url: string; meta?: { title?: string }; excerpt?: string }> }) => item.data()));
          if (data.length) {
            const heading = document.createElement("div");
            heading.className = "px-3 pt-3 text-[11px] uppercase tracking-wider text-[color:var(--fg-muted)]";
            heading.textContent = "Full-text";
            results.append(heading);
            for (const item of data) {
              const a = document.createElement("a");
              a.href = item.url;
              a.className = "block rounded-md px-3 py-2 hover:bg-[color:var(--bg-muted)] no-underline text-[color:var(--fg)]";
              a.innerHTML = pagefindHitHtml(item.meta?.title ?? item.url, item.excerpt ?? "");
              results.append(a);
            }
          }
        } catch {
          // Pagefind is optional until the index exists.
        }
      }

      function openSearch() {
        dialog?.showModal();
        input?.focus();
        void runSearch();
      }
      document.getElementById("search-open")?.addEventListener("click", openSearch);
      document.addEventListener("keydown", (event) => {
        if (event.key === "/" && event.target === document.body || (event.key === "/" && !(event.target instanceof HTMLInputElement))) {
          event.preventDefault();
          openSearch();
        }
        if (event.key === "k" && (event.metaKey || event.ctrlKey)) {
          event.preventDefault();
          openSearch();
        }
      });
      input?.addEventListener("input", () => runSearch());
    </script>
  </body>
</html>
