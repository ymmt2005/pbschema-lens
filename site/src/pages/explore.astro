---
import Layout from "../layouts/Layout.astro";
import { configuredBase, loadModel } from "../lib/data.ts";
import { linkedPath } from "../lib/format.ts";
import { incomingReferencesHtml } from "../lib/search-ui.ts";

const model = loadModel();
const pageable = Object.values(model.symbols).filter((item) => item.generatePage);
---

<Layout title="Used-by explorer">
  <h1 class="text-3xl font-semibold mb-3">Used-by explorer</h1>
  <p class="text-[color:var(--fg-muted)] mb-6 max-w-2xl">
    Pick a documented symbol to see reverse references. This is the same graph used on each symbol page, without
    dumping thousands of Timestamp users into a single HTML blob.
  </p>
  <label class="text-sm block mb-2" for="symbol-select">Symbol</label>
  <select id="symbol-select" class="w-full max-w-xl rounded-md border border-[color:var(--line)] bg-[color:var(--bg-raised)] px-3 py-2">
    <option value="">Choose a symbol…</option>
    {pageable.map((item) => (
      <option value={item.id}>{item.kind} · {item.fullName}</option>
    ))}
  </select>
  <div id="explorer-out" class="mt-6 text-sm"></div>
  <script
    id="explorer-data"
    type="application/json"
    set:html={JSON.stringify({
      items: pageable.map((item) => ({
        id: item.id,
        fullName: item.fullName,
        refs: item.referencedBy.map((ref) => ({ fromId: ref.fromId, kind: ref.kind })),
      })),
      names: Object.fromEntries(Object.values(model.symbols).map((item) => [item.id, item.fullName])),
      hrefs: Object.fromEntries(Object.values(model.symbols).map((item) => [item.id, linkedPath(item, model.symbols) ?? ""])),
      base: configuredBase(),
    }).replaceAll("<", "\\u003c")}
  />
  <script>
    import { incomingReferencesHtml } from "../lib/search-ui.ts";

    const payload = JSON.parse(document.getElementById("explorer-data")?.textContent || "{}") as {
      items: Array<{ id: string; fullName: string; refs: Array<{ fromId: string; kind: string }> }>;
      names: Record<string, string>;
      hrefs: Record<string, string>;
      base: string;
    };
    const select = document.getElementById("symbol-select") as HTMLSelectElement | null;
    const out = document.getElementById("explorer-out");
    const byId = Object.fromEntries(payload.items.map((item) => [item.id, item]));
    const prefix = payload.base.endsWith("/") ? payload.base.slice(0, -1) : payload.base;
    select?.addEventListener("change", () => {
      const item = byId[select.value];
      if (!out) return;
      if (!item) {
        out.innerHTML = "";
        return;
      }
      out.innerHTML = incomingReferencesHtml(item.fullName, item.refs, payload.names, payload.hrefs, prefix);
    });
  </script>
</Layout>
