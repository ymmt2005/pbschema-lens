---
import Layout from "../../layouts/Layout.astro";
import { loadModel, withBase } from "../../lib/data.ts";
import { highlightProto } from "../../lib/format.ts";

export function getStaticPaths() {
  return loadModel()
    .files.filter((file) => file.sourceText)
    .map((file) => ({ params: { path: file.fullName } }));
}

const model = loadModel();
const pathParam = Astro.params.path;
const path = Array.isArray(pathParam) ? pathParam.join("/") : pathParam;
const file = path ? model.files.find((item) => item.fullName === path) : undefined;
---

<Layout title={file ? file.fullName : "Source"}>
  {
    !file ? (
      <div>
        <h1 class="text-3xl font-semibold mb-4">Source</h1>
        <p class="text-[color:var(--fg-muted)] mb-4">Embedded .proto sources for this schema.</p>
        <ul class="space-y-1">
          {model.files.filter((item) => item.sourceText).map((item) => (
            <li>
              <a href={withBase(item.urlPath)}>{item.fullName}</a>
              <span class="text-xs text-[color:var(--fg-muted)]"> · {item.syntax}{item.edition ? ` ${item.edition}` : ""}</span>
            </li>
          ))}
        </ul>
        {model.files.every((item) => !item.sourceText) && (
          <p>No source text was available. Descriptor-only builds omit the source browser.</p>
        )}
      </div>
    ) : (
      <div>
        <p class="text-xs uppercase tracking-wider text-[color:var(--accent)] font-semibold">Source</p>
        <h1 class="text-2xl font-semibold mt-1 break-all">{file.fullName}</h1>
        <p class="text-sm text-[color:var(--fg-muted)] mt-2">
          {file.syntax}{file.edition ? ` · edition ${file.edition}` : ""} · package {file.packageName || "(unnamed)"}
        </p>
        <pre class="proto mt-6" set:html={highlightProto(file.sourceText ?? "")} />
      </div>
    )
  }
</Layout>
