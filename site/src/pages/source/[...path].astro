---
import Layout from "../../layouts/Layout.astro";
import SourceExplorer from "../../components/SourceExplorer.astro";
import { loadModel } from "../../lib/data.ts";
import { highlightProto } from "../../lib/format.ts";

export function getStaticPaths() {
  return loadModel()
    .files.filter((file) => file.sourceText)
    .map((file) => ({ params: { path: file.fullName } }));
}

const model = loadModel();
const pathParam = Astro.params.path;
const path = Array.isArray(pathParam) ? pathParam.join("/") : pathParam;
const file = path ? model.files.find((item) => item.fullName === path && item.sourceText) : undefined;
const lines = file?.sourceText?.split(/\r?\n/) ?? [];
const parts = file?.fullName.split("/").filter((part) => part.length > 0) ?? [];
const filename = parts.at(-1);
const dirs = parts.slice(0, -1);
---

<Layout title={file ? file.fullName : "Source"}>
  {
    !file ? (
      <SourceExplorer files={model.files}>
        <h1 class="text-3xl font-semibold mb-2">Source</h1>
        <p class="text-[color:var(--fg-muted)]">Browse the embedded .proto files for this schema.</p>
      </SourceExplorer>
    ) : (
      <SourceExplorer files={model.files} active={file.fullName}>
        <p class="text-xs uppercase tracking-wider text-[color:var(--accent)] font-semibold">Source</p>
        {
          dirs.length > 0 && (
            <ol class="source-crumb">
              {dirs.map((dir) => (
                <li>{dir}</li>
              ))}
            </ol>
          )
        }
        <h1 class="text-2xl font-semibold mt-1 break-all">{filename}</h1>
        <p class="text-sm text-[color:var(--fg-muted)] mt-2">
          {file.syntax}
          {file.edition ? ` · edition ${file.edition}` : ""} · package {file.packageName || "(unnamed)"}
        </p>
        <div class="source-view mt-6 font-mono text-[0.8rem] leading-6 border border-[color:var(--line)] rounded-xl overflow-x-auto bg-[color:var(--bg-raised)]">
          {lines.map((line, index) => (
            <div id={`L${index + 1}`} class="source-line flex gap-3 px-3 hover:bg-[color:var(--bg-muted)]">
              <a class="w-10 shrink-0 text-right text-[color:var(--fg-muted)] no-underline select-none" href={`#L${index + 1}`}>
                {index + 1}
              </a>
              <code class="whitespace-pre grow" set:html={highlightProto(line.length ? line : " ")} />
            </div>
          ))}
        </div>
      </SourceExplorer>
    )
  }
</Layout>

<style>
  .source-line:target {
    background: color-mix(in srgb, var(--accent) 18%, transparent);
  }
</style>
