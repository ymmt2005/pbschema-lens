---
import Layout from "../../layouts/Layout.astro";
import SourceExplorer from "../../components/SourceExplorer.astro";
import { loadModel } from "../../lib/data.ts";

const model = loadModel();
const files = model.files.filter((file) => file.sourceText);
---

<Layout title="Source">
  {
    files.length === 0 ? (
      <div>
        <h1 class="text-3xl font-semibold mb-4">Source</h1>
        <p>No source text was available. Descriptor-only builds omit the source browser.</p>
      </div>
    ) : (
      <SourceExplorer files={files}>
        <h1 class="text-3xl font-semibold mb-2">Source</h1>
        <p class="text-[color:var(--fg-muted)]">Browse the embedded .proto files for this schema.</p>
      </SourceExplorer>
    )
  }
</Layout>
