---
import Layout from "../../../layouts/Layout.astro";
import SymbolHeader from "../../../components/SymbolHeader.astro";
import OptionList from "../../../components/OptionList.astro";
import UsedBy from "../../../components/UsedBy.astro";
import { loadModel } from "../../../lib/data.ts";
import { symbolHref, typeHref } from "../../../lib/format.ts";

export function getStaticPaths() {
  return loadModel()
    .services.filter((item) => item.generatePage)
    .map((item) => ({ params: { name: item.fullName } }));
}

const model = loadModel();
const service = model.services.find((item) => item.fullName === Astro.params.name);
if (!service) throw new Error("Missing service");
const methods = service.methodIds.map((id) => model.methods.find((item) => item.id === id)!).filter(Boolean);
---

<Layout title={service.fullName}>
  <SymbolHeader symbol={service} />
  <div class="table-wrap mb-8">
    <table class="fields">
      <thead>
        <tr>
          <th>RPC</th>
          <th>Request</th>
          <th>Response</th>
          <th>Streaming</th>
        </tr>
      </thead>
      <tbody>
        {methods.map((method) => (
          <tr>
            <td>
              <a class="font-mono no-underline text-[color:var(--fg)]" href={symbolHref(method)}>{method.shortName}</a>
              {method.deprecated ? <div class="text-xs text-red-700">deprecated</div> : null}
            </td>
            <td class="font-mono text-xs">{typeHref(method.input) ? <a href={typeHref(method.input)}>{method.input.name}</a> : method.input.name}</td>
            <td class="font-mono text-xs">{typeHref(method.output) ? <a href={typeHref(method.output)}>{method.output.name}</a> : method.output.name}</td>
            <td class="text-xs">
              <span class="inline-flex flex-wrap gap-1">
                {method.clientStreaming && <span class="stream-chip">client</span>}
                {method.serverStreaming && <span class="stream-chip">server</span>}
                {!method.clientStreaming && !method.serverStreaming && <span class="text-[color:var(--fg-muted)]">unary</span>}
              </span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <OptionList options={service.options} />
  <UsedBy symbol={service} model={model} />
</Layout>
