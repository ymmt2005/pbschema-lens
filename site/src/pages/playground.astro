---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Descriptor playground">
  <h1 class="text-3xl font-semibold mb-3">Descriptor playground</h1>
  <p class="text-[color:var(--fg-muted)] max-w-2xl mb-6">
    Drop a <code>FileDescriptorSet</code> (<code>.binpb</code>) onto this page. Parsing happens in your browser. Nothing
    is uploaded.
  </p>
  <input id="file" type="file" accept=".binpb,.pb,.desc" class="mb-4" />
  <pre id="out" class="option min-h-40">Waiting for a descriptor set…</pre>
  <script>
    const input = document.getElementById("file");
    const out = document.getElementById("out");
    input?.addEventListener("change", async (event) => {
      const file = event.target.files?.[0];
      if (!file) return;
      const bytes = new Uint8Array(await file.arrayBuffer());
      try {
        const { loadRegistryFromBytes, buildModel } = await import("pbschema-lens/core");
        const registry = loadRegistryFromBytes(bytes);
        const model = buildModel(registry, {
          title: file.name,
          inputLabel: file.name,
          classification: {},
        });
        const summary = [
          `${model.buildInfo.fileCount} files`,
          `${model.buildInfo.symbolCount} symbols`,
          `${model.services.length} services`,
          `${model.messages.length} messages`,
          `${model.extensions.length} extensions`,
          "",
          ...model.packages.map((pkg) => `- ${pkg.fullName}`),
        ].join("\n");
        out.textContent = summary;
      } catch (error) {
        out.textContent = error instanceof Error ? error.message : String(error);
      }
    });
  </script>
</Layout>
