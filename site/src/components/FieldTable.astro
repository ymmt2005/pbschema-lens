---
import type { DocField, DocOneof, SchemaModel } from "../../../src/core/types.ts";
import { fieldTableEntries, isValidationRenderer, validationChips } from "pbschema-lens/core";
import { typeHref } from "../lib/format.ts";

interface Props {
  fields: DocField[];
  oneofs?: DocOneof[];
  model: SchemaModel;
  /** Keeps request and response field ids distinct when two tables share a page. */
  anchorPrefix?: string;
}

const { fields, oneofs = [], anchorPrefix = "" } = Astro.props;
const entries = fieldTableEntries(fields, oneofs);

function domId(anchor: string | undefined): string | undefined {
  return anchor ? `${anchorPrefix}${anchor}` : undefined;
}

function typeLabel(field: DocField): string {
  if (field.cardinality === "map") {
    return `map<${field.mapKey?.name ?? "string"}, ${field.mapValue?.name ?? "string"}>`;
  }
  return field.type.name;
}

function otherAnnotationBadges(field: DocField): string[] {
  return field.options.flatMap((option) =>
    option.semantic && !isValidationRenderer(option.semantic.rendererId) ? (option.semantic.badges ?? []) : [],
  );
}

function oneofRequired(oneof: DocOneof): boolean {
  return validationChips(oneof.options).includes("required");
}
---

<div class="table-wrap">
  <table class="fields schema-fields">
    <colgroup>
      <col class="col-field" />
      <col class="col-number" />
      <col class="col-type" />
      <col class="col-cardinality" />
      <col class="col-validation" />
      <col class="col-description" />
    </colgroup>
    <thead>
      <tr>
        <th>Field</th>
        <th>Number</th>
        <th>Type</th>
        <th>Cardinality</th>
        <th>Validation</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      {
        entries.map((entry) => {
          if (entry.kind === "oneof") {
            const { oneof, members } = entry;
            const chips = validationChips(oneof.options);
            const required = oneofRequired(oneof);
            return (
              <>
                <tr id={domId(oneof.anchor)} class="oneof">
                  <td>
                    <a class="font-mono no-underline text-[color:var(--fg)]" href={`#${domId(oneof.anchor)}`}>
                      {oneof.shortName}
                    </a>
                    <div class="text-[11px] text-[color:var(--fg-muted)]">oneof</div>
                  </td>
                  <td class="text-[color:var(--fg-muted)]">—</td>
                  <td class="font-mono text-xs">oneof</td>
                  <td class="text-xs">{required ? "required" : "optional"}</td>
                  <td>
                    {chips.length ? (
                      <div class="flex flex-wrap gap-1">
                        {chips.map((chip) => (
                          <span class="validation-chip">{chip}</span>
                        ))}
                      </div>
                    ) : (
                      <span class="text-[color:var(--fg-muted)]">—</span>
                    )}
                  </td>
                  <td>
                    {oneof.comments?.markdownHtml ? <div class="prose-doc text-sm" set:html={oneof.comments.markdownHtml} /> : null}
                    <p class="text-sm text-[color:var(--fg-muted)]">
                      {required ? "Exactly one of " : "At most one of "}{members.map((member, index) => (
                        <Fragment>{index > 0 ? ", " : ""}<a href={`#${domId(member.anchor)}`}>{member.shortName}</a></Fragment>
                      ))}.</p>
                    {oneof.options.length > 0 && (
                      <details class="mt-2 text-xs">
                        <summary class="cursor-pointer text-[color:var(--fg-muted)]">Details</summary>
                        <pre class="option mt-2">{oneof.options.map((option) => option.textProto).join("\n")}</pre>
                      </details>
                    )}
                  </td>
                </tr>
                {members.map((field) => {
                  const href = field.cardinality === "map" ? typeHref(field.mapValue) : typeHref(field.type);
                  const memberChips = validationChips(field.options);
                  const annotations = otherAnnotationBadges(field);
                  return (
                    <tr id={domId(field.anchor)} class="oneof-member">
                      <td>
                        <a class="font-mono no-underline text-[color:var(--fg)]" href={`#${domId(field.anchor)}`}>
                          {field.shortName}
                        </a>
                        {field.deprecated ? <span class="ml-2 text-xs text-red-700">deprecated</span> : null}
                        <div class="text-[11px] text-[color:var(--fg-muted)]">
                          in <a href={`#${domId(oneof.anchor)}`}>{oneof.shortName}</a>
                        </div>
                      </td>
                      <td class="num">{field.number}</td>
                      <td class="font-mono text-xs">
                        {href ? <a href={href}>{typeLabel(field)}</a> : typeLabel(field)}
                      </td>
                      <td class="text-xs">{field.cardinality}</td>
                      <td>
                        {memberChips.length ? (
                          <div class="flex flex-wrap gap-1">
                            {memberChips.map((chip) => (
                              <span class="validation-chip">{chip}</span>
                            ))}
                          </div>
                        ) : (
                          <span class="text-[color:var(--fg-muted)]">—</span>
                        )}
                      </td>
                      <td>
                        {field.comments?.markdownHtml ? <div class="prose-doc text-sm" set:html={field.comments.markdownHtml} /> : <span class="text-[color:var(--fg-muted)]">—</span>}
                        <details class="mt-2 text-xs">
                          <summary class="cursor-pointer text-[color:var(--fg-muted)]">Details</summary>
                          <ul class="mt-2 space-y-1 text-[color:var(--fg-muted)]">
                            <li>JSON name: <code>{field.jsonName}</code></li>
                            <li>Presence: {field.presence}</li>
                            {field.packed !== undefined ? <li>Packed: {String(field.packed)}</li> : null}
                            {field.defaultValue ? <li>Default: {field.defaultValue}</li> : null}
                            {annotations.length ? <li>Annotations: {annotations.join(", ")}</li> : null}
                          </ul>
                          {field.options.length > 0 && (
                            <pre class="option mt-2">{field.options.map((option) => option.textProto).join("\n")}</pre>
                          )}
                        </details>
                      </td>
                    </tr>
                  );
                })}
              </>
            );
          }

          const field = entry.field;
          const href = field.cardinality === "map" ? typeHref(field.mapValue) : typeHref(field.type);
          const chips = validationChips(field.options);
          const annotations = otherAnnotationBadges(field);
          return (
            <tr id={domId(field.anchor)}>
              <td>
                <a class="font-mono no-underline text-[color:var(--fg)]" href={`#${domId(field.anchor)}`}>
                  {field.shortName}
                </a>
                {field.deprecated ? <span class="ml-2 text-xs text-red-700">deprecated</span> : null}
              </td>
              <td class="num">{field.number}</td>
              <td class="font-mono text-xs">
                {href ? <a href={href}>{typeLabel(field)}</a> : typeLabel(field)}
              </td>
              <td class="text-xs">{field.cardinality}</td>
              <td>
                {chips.length ? (
                  <div class="flex flex-wrap gap-1">
                    {chips.map((chip) => (
                      <span class="validation-chip">{chip}</span>
                    ))}
                  </div>
                ) : (
                  <span class="text-[color:var(--fg-muted)]">—</span>
                )}
              </td>
              <td>
                {field.comments?.markdownHtml ? <div class="prose-doc text-sm" set:html={field.comments.markdownHtml} /> : <span class="text-[color:var(--fg-muted)]">—</span>}
                <details class="mt-2 text-xs">
                  <summary class="cursor-pointer text-[color:var(--fg-muted)]">Details</summary>
                  <ul class="mt-2 space-y-1 text-[color:var(--fg-muted)]">
                    <li>JSON name: <code>{field.jsonName}</code></li>
                    <li>Presence: {field.presence}</li>
                    {field.packed !== undefined ? <li>Packed: {String(field.packed)}</li> : null}
                    {field.defaultValue ? <li>Default: {field.defaultValue}</li> : null}
                    {annotations.length ? <li>Annotations: {annotations.join(", ")}</li> : null}
                  </ul>
                  {field.options.length > 0 && (
                    <pre class="option mt-2">{field.options.map((option) => option.textProto).join("\n")}</pre>
                  )}
                </details>
              </td>
            </tr>
          );
        })
      }
      {
        fields.length === 0 && (
          <tr>
            <td colspan="6" class="text-[color:var(--fg-muted)]">
              This message has no fields.
            </td>
          </tr>
        )
      }
    </tbody>
  </table>
</div>
