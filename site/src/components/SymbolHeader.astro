---
import type { DocSymbol } from "../../../src/core/types.ts";
import { kindLabel, symbolHref } from "../lib/format.ts";
import { withBase } from "../lib/data.ts";

interface Props {
  symbol: DocSymbol;
}

const { symbol } = Astro.props;
---

<header class="mb-8">
  <div class={`text-xs font-semibold uppercase tracking-wider kind-${symbol.kind}`}>{kindLabel(symbol.kind)}</div>
  <h1 class="text-3xl font-semibold mt-1 break-all">{symbol.shortName}</h1>
  <p class="font-mono text-sm text-[color:var(--fg-muted)] mt-2 break-all">{symbol.fullName}</p>
  <div class="flex flex-wrap gap-2 mt-3 text-xs">
    {
      symbol.deprecated && (
        <span class="rounded-full bg-red-100 text-red-800 dark:bg-red-950 dark:text-red-200 px-2 py-0.5">deprecated</span>
      )
    }
    <span class="rounded-full bg-[color:var(--bg-muted)] px-2 py-0.5">{symbol.domain}</span>
    {
      symbol.packageName && (
        <a class="rounded-full bg-[color:var(--bg-muted)] px-2 py-0.5 no-underline text-[color:var(--fg)]" href={withBase(`/reference/packages/${encodeURIComponent(symbol.packageName)}/`)}>
          {symbol.packageName}
        </a>
      )
    }
    {
      symbol.fileName && (
        <a class="rounded-full bg-[color:var(--bg-muted)] px-2 py-0.5 no-underline text-[color:var(--fg)]" href={withBase(`/source/${symbol.fileName.split("/").map(encodeURIComponent).join("/")}/`)}>
          {symbol.fileName}
        </a>
      )
    }
    {
      symbol.sourceLink && (
        <a class="rounded-full border border-[color:var(--line)] px-2 py-0.5 no-underline text-[color:var(--fg)]" href={symbol.sourceLink.url}>
          View source
        </a>
      )
    }
  </div>
  {
    symbol.comments?.markdownHtml && (
      <div class="prose-doc mt-5 text-[0.98rem] leading-7" set:html={symbol.comments.markdownHtml} />
    )
  }
</header>
